# Obrigatória, mínimo 32 caracteres. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
TOKEN_EXPIRATION_HOURS=1
DEBUG=True

DATABASE_URL=sqlite:///./healthassist.db

# Allowlist de origens para CORS, separadas por vírgula. Nunca usar "*".
CORS_ORIGINS=http://localhost:3000

# Limite de tentativas em /auth/token (sintaxe do slowapi: "N/unidade").
RATE_LIMIT_AUTH=5/minute

# Senhas usadas apenas por scripts/seed.py para criar usuários de teste.
SEED_ADMIN_PASSWORD=
SEED_ALICE_PASSWORD=
SEED_BOB_PASSWORD=
